# Copy this file as ".env" and enter your real values.
# Do not upload the .env file to GitHub.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=hotel_bar_db

# Increase this value only if the application has a higher load.
DB_POOL_SIZE=10

APP_NAME=Your Hotel Name
HOTEL_PHONE=9876543210
HOTEL_ADDRESS=Your hotel address
HOTEL_GSTIN=Your GSTIN number
HOTEL_FSSAI=Your FSSAI licence number

# Allowed frontend addresses (use commas for more than one address).
FRONTEND_ORIGIN=http://127.0.0.1:8000,http://localhost:8000

PORT=5000
FLASK_DEBUG=1
